#!/usr/bin/env bash
set -euo pipefail

if (( $# != 0 )); then
  echo "Usage: scripts/test" >&2
  exit 2
fi

PROJECT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
PYTHON_BIN="${PROJECT_DIR}/.venv/bin/python"
if [[ ! -x "${PYTHON_BIN}" ]]; then
  PYTHON_BIN="$(command -v python3)"
fi
PYTHONPATH="${PROJECT_DIR}/src" "${PYTHON_BIN}" -m unittest discover -s "${PROJECT_DIR}/tests"
