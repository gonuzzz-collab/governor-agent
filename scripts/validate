#!/usr/bin/env bash
set -euo pipefail

if (( $# != 0 )); then
  echo "Usage: scripts/validate" >&2
  exit 2
fi

PROJECT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
REPO_ROOT="$(cd "${PROJECT_DIR}/../.." && pwd)"
RUFF_BIN="${PROJECT_DIR}/.venv/bin/ruff"

if [[ ! -x "${RUFF_BIN}" ]]; then
  echo "[FAIL] locked Ruff executable missing; run uv sync --locked" >&2
  exit 1
fi

if [[ -x "${REPO_ROOT}/.skills/factory-check" ]]; then
  "${REPO_ROOT}/.skills/factory-check" --project "${PROJECT_DIR}" --strict
else
  echo "[SKIP] Private factory-check is unavailable; running standalone project gates."
fi
"${RUFF_BIN}" check "${PROJECT_DIR}/src" "${PROJECT_DIR}/tests" "${PROJECT_DIR}/fixtures/demo_factory/project"
"${RUFF_BIN}" format --check "${PROJECT_DIR}/src" "${PROJECT_DIR}/tests" "${PROJECT_DIR}/fixtures/demo_factory/project"
"${PROJECT_DIR}/scripts/doctor"
"${PROJECT_DIR}/scripts/test"
