#!/usr/bin/env python3
"""Emit compact gonucleo.evidence.v1 for this generated project."""

from __future__ import annotations

import argparse
import json
import subprocess
from pathlib import Path


PROJECT_DIR = Path(__file__).resolve().parent.parent


def run_check(name: str) -> int:
    try:
        result = subprocess.run(
            [str(PROJECT_DIR / "scripts" / name)],
            cwd=PROJECT_DIR,
            check=False,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
        return result.returncode
    except OSError:
        return 127


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--mode", choices=("summary", "detail"), default="summary")
    parser.add_argument("--format", choices=("text", "json"), default="text")
    args = parser.parse_args()

    exits = {name: run_check(name) for name in ("validate", "doctor")}
    checks = {name: "ok" if code == 0 else "fail" for name, code in exits.items()}
    failed = sorted(name for name, status in checks.items() if status == "fail")
    status = "fail" if failed else "ok"
    result: dict[str, object] = {
        "schema_version": "gonucleo.evidence.v1",
        "producer": {"id": f"{PROJECT_DIR.name}.scripts.evidence", "version": "1"},
        "project": PROJECT_DIR.name,
        "status": status,
        "summary": (
            "Generated project checks passed"
            if not failed
            else f"Generated project checks failed: {', '.join(failed)}"
        ),
        "checks": checks,
        "metrics": {
            "checks_total": len(checks),
            "checks_passed": sum(value == "ok" for value in checks.values()),
            "checks_failed": len(failed),
        },
        "limitations": [
            "Generated adapter evidence; no runtime, network, real data or external service was inspected.",
            "Detailed mode reports exit codes only and does not include raw command output.",
        ],
    }
    if args.mode == "detail":
        result["detail"] = [f"{name}: exit={code}" for name, code in sorted(exits.items())]

    if args.format == "json":
        print(json.dumps(result, ensure_ascii=False, indent=2, sort_keys=True))
    else:
        print("# GoNucleo Project Evidence")
        print(f"- Project: {PROJECT_DIR.name}")
        print(f"- Result: {status.upper()}")
        for name, check_status in checks.items():
            print(f"- {name}: {check_status}")
    return 0 if status == "ok" else 1


if __name__ == "__main__":
    raise SystemExit(main())
